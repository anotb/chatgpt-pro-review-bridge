{
  "name": "chatgpt-pro-review-bridge",
  "version": "0.8.2",
  "description": "Lean TypeScript bridge for user-directed workflows in visible ChatGPT sessions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anotb/chatgpt-bridge.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/anotb/chatgpt-bridge#readme",
  "bugs": {
    "url": "https://github.com/anotb/chatgpt-bridge/issues"
  },
  "keywords": [
    "codex",
    "chatgpt",
    "browser-automation",
    "visible-ui",
    "agents",
    "typescript"
  ],
  "scripts": {
    "build": "node clean.mjs && tsc -p tsconfig.json",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/chatgpt-bridge.bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/chatgpt-bridge.bundle.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^24.13.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  }
}
